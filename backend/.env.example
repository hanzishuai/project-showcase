# 复制为 backend/.env 后填写；backend/.env 已被 .gitignore 忽略，不会入库。
# 未配置语音密钥时，前端语音入口会自动隐藏；问答仍可用。

# ── 百炼 / DashScope（TTS 语音合成 + ASR 语音识别） ──
DASHSCOPE_API_KEY=sk-请填写
# 兼容旧变量名（任选其一）：TTS_API_KEY / OMNI_API_KEY
# TTS_API_KEY=
# OMNI_API_KEY=

# ── 问答模型（任意 OpenAI 兼容 /chat/completions 服务） ──
LLM_API_KEY=sk-请填写
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# 可选：主通道失败时的备用通道（百炼兼容模式）
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_FALLBACK_MODEL=qwen-flash

# ── 语音模型 / 音色 ──
TTS_MODEL=qwen3-tts-flash
TTS_VOICE=Cherry
ASR_MODEL=qwen3-asr-flash-realtime

# ── 数字人人设 ──
RAG_ASSISTANT_NAME=平台助手
RAG_PLATFORM_NAME=软件学院项目实践聚合平台

# ── 知识检索 ──
RAG_TOP_K=3
# 国内网络可保留 HF 镜像
HF_ENDPOINT=https://hf-mirror.com

# ── 上线安全 / 运维（可选） ──
# 管理口令：设置后管理后台、问答日志、知识库管理、项目写接口需要请求头 X-Admin-Token。
# 监听非 127.0.0.1 时 start.ps1 会强制要求设置；本机演示可不设。
ADMIN_TOKEN=
# 费用型接口限流（每 IP 每分钟，0=关闭，默认 120）
APP_RATE_LIMIT_PER_MIN=120
# 生产建议关闭 /docs 与 /openapi.json
APP_ENABLE_DOCS=1
# 启动预热（离线/测试环境可设 0）
APP_WARMUP=1
# 可选：把应用日志写入文件
APP_LOG_FILE=
